APP_NAME="PUSKOM Antrian UNIMA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Makassar

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=puskom_antrian
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Pengaturan bisnis sistem antrian (dibaca di config/queue_system.php)
QUEUE_DEFAULT_SERVICE_MINUTES=5
QUEUE_RESET_DAILY=true
QUEUE_OFFICE_START=08:00
QUEUE_OFFICE_END=16:00
